# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
.env
.env.*
!.env.example

# uv
# Keep uv.lock tracked for reproducibility; ignore cache
.uv/

# Notebooks — Jupytext pairs .ipynb with .py; commit .py, ignore .ipynb
# (override per-file with `git add -f` when a notebook's output matters)
*.ipynb
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Data
# Raw .mat files are tracked (source of truth).
# Processed pickles are derivable — keep them local, don't commit.
data/processed/*
!data/processed/.gitkeep
# Filter-variant pickle trees (e.g. data/processed_posend515/, Phase 5 Item 6)
data/processed_*/

# Results / logs — generated artifacts stay local (incl. variant trees like results_posend515/)
results/
results_*/
logs/
*.log

# Thesis drafts / large artifacts
*.pdf
!docs/**/*.pdf
.mat

# Datasets — kept locally only (lab data, not ours to redistribute)
# See specs/decisions.md D-013 and data/raw/README.md for sourcing instructions.
*.mat

# Legacy workspace — kept locally for context, but never committed.
# Contains old code AND data-derived artifacts (processed pickles, model weights,
# experiment outputs) from lab recordings. See specs/decisions.md D-014.
_legacy/
/external/scriptspipeline
docs/dudas.md
docs/pre-procesamiento.md

# Data-derived artifacts at any path (extra defence beyond *.mat and _legacy/)
*.pickle
*.pkl
*.pth
*.npy
*.npz
*.h5
*.hdf5
*.key
